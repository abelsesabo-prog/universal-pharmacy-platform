PORT=10000
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DATABASE=universal_pharmacy

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Authentication bootstrap identity.
# AUTH_PASSWORD_HASH must be a bcrypt hash; never commit the real password.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTH_USERNAME=REPLACE_WITH_ADMIN_USERNAME
AUTH_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
AUTH_TENANT_ID=REPLACE_WITH_TENANT_ID
AUTH_ROLE=admin
